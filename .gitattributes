###############################################################################
# 默认自动规范化行尾。
###############################################################################
* text=auto

###############################################################################
# 设置命令行差异比较的默认行为。
#
# 较早版本的 msysgit 默认未对 C# 文件启用此功能，
# 因此需要此设置。
# 注意：此设置仅用于命令行
###############################################################################
#*.cs     diff=csharp

###############################################################################
# 设置项目与解决方案文件的合并驱动
#
# 从命令行合并时，如有冲突，会在文件中加入差异标记
# （从 VS 合并不受下方设置影响，VS 不会插入差异标记）。
# 差异标记可能导致下列扩展名的文件无法在 VS 中加载。
# 另一种方式是将这些文件视为二进制文件，但这样每次合并
# 都会产生冲突，需要用户手动处理。
# 如需采用此方式，取消下方条目的注释即可
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# 图像文件的处理方式
#
# 默认将图像文件视为二进制文件。
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# 常见文档格式的差异比较方式
# 
# 在比较差异之前，将二进制文档转换为文本。此功能
# 仅适用于命令行。取消下方条目的注释
# 即可启用。
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain
